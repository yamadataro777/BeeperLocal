{
  "display_information": {
    "name": "BeeperLocal PoC",
    "description": "Local user-authorized messaging integration"
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "im:read",
        "im:history",
        "mpim:read",
        "mpim:history",
        "chat:write",
        "users:read",
        "files:read",
        "files:write"
      ]
    },
    "pkce_enabled": true,
    "redirect_urls": [
      "beeperlocal://oauth/slack"
    ]
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
